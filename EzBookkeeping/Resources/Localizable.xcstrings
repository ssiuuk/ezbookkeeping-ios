          "stringUnit": {
            "state": "translated",
            "value": "ಸರ್ವರ್ ಅನ್ನು ತಲುಪಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de server niet bereiken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z serwerem"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul nu poate fi accesat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся связаться с сервером"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strežnika ni mogoče doseči"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேவையகத்தை அடைய முடியவில்லை"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya ulaşılamıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається зв’язатися із сервером"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối với máy chủ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到伺服器"
          }
        }
      }
    },
    "Can't reach the server, and nothing from it is saved on this phone yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nicht erreichbar, und auf diesem Telefon ist noch nichts von ihm gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν είναι προσβάσιμος και δεν έχει αποθηκευτεί ακόμη τίποτα από αυτόν σε αυτό το τηλέφωνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el servidor y todavía no hay nada suyo guardado en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur, et rien de lui n’est encore enregistré sur ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il server, e su questo telefono non è ancora salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できません。この端末にはまだサーバーのデータが保存されていません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸರ್ವರ್ ತಲುಪಲು ಆಗುತ್ತಿಲ್ಲ, ಮತ್ತು ಅದರಿಂದ ಏನೂ ಈ ಫೋನ್‌ನಲ್ಲಿ ಇನ್ನೂ ಉಳಿಸಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없으며, 이 휴대전화에 저장된 서버 데이터도 아직 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server is niet bereikbaar, en er is nog niets van hem op deze telefoon bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z serwerem, a na tym telefonie nie ma jeszcze zapisanych jego danych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor, e nada dele está salvo neste telefone ainda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul nu poate fi accesat și nimic de la el nu este salvat încă pe acest telefon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер недоступен, и на этом телефоне от него пока ничего не сохранено."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strežnik ni dosegljiv in na tem telefonu še ni shranjeno nič od njega."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேவையகத்தை அணுக முடியவில்லை, அதிலிருந்து எதுவும் இந்தத் தொலைபேசியில் இன்னும் சேமிக்கப்படவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ และยังไม่มีข้อมูลจากเซิร์ฟเวอร์บันทึกไว้ในโทรศัพท์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya ulaşılamıyor ve bu telefonda henüz ondan kaydedilmiş bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер недоступний, і на цьому телефоні від нього ще нічого не збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được máy chủ, và điện thoại này chưa lưu dữ liệu nào từ máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器，本机也还没有保存它的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至伺服器，本機也還沒有儲存它的資料。"
          }
        }
      }
    },
    "Can't reach the server. Showing what it sent at %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nicht erreichbar. Angezeigt wird der Stand von %1$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν είναι προσβάσιμος. Εμφανίζονται τα στοιχεία των %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el servidor. Se muestra lo que envió a las %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur. Affichage des données de %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il server. Vengono mostrati i dati delle %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できません。%1$@ 時点のデータを表示しています。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸರ್ವರ್ ತಲುಪಲು ಆಗುತ್ತಿಲ್ಲ. %1$@ ರ ಮಾಹಿತಿಯನ್ನು ತೋರಿಸಲಾಗುತ್ತಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다. %1$@ 기준 데이터를 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server is niet bereikbaar. Je ziet wat hij om %1$@ stuurde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z serwerem. Pokazano dane z %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor. Mostrando o que ele enviou às %1$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul nu poate fi accesat. Se afișează ce a trimis la %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер недоступен. Показаны данные на %1$@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strežnik ni dosegljiv. Prikazano je stanje ob %1$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேவையகத்தை அணுக முடியவில்லை. %1$@ நிலவரம் காட்டப்படுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ กำลังแสดงข้อมูล ณ %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya ulaşılamıyor. %1$@ itibarıyla gönderilenler gösteriliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер недоступний. Показано дані станом на %1$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được máy chủ. Đang hiển thị dữ liệu lúc %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器。显示的是 %1$@ 时的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至伺服器。顯示的是 %1$@ 時的資料。"
          }
        }
      }
    },
