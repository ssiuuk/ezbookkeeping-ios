    "Use this for single sign-on or to create an account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Single Sign-On oder zum Erstellen eines Kontos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για ενιαία σύνδεση (SSO) ή για δημιουργία λογαριασμού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsalo para el inicio de sesión único o para crear una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l’authentification unique ou pour créer un compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usalo per il single sign-on o per creare un account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シングルサインオンやアカウント作成に使います。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏಕ ಸೈನ್-ಆನ್‌ಗಾಗಿ ಅಥವಾ ಖಾತೆ ರಚಿಸಲು ಇದನ್ನು ಬಳಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "싱글 사인온을 사용하거나 계정을 만들 때 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik dit voor single sign-on of om een account aan te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj do logowania jednokrotnego lub aby utworzyć konto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use para login único (SSO) ou para criar uma conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește această opțiune pentru autentificare unică sau pentru a crea un cont."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для единого входа или чтобы создать аккаунт."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za enotno prijavo ali za ustvarjanje računa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒற்றை உள்நுழைவுக்கு அல்லது கணக்கை உருவாக்க இதைப் பயன்படுத்தவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สำหรับการลงชื่อเข้าใช้ครั้งเดียว (SSO) หรือเพื่อสร้างบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek oturum açma için ya da hesap oluşturmak için kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для єдиного входу або щоб створити обліковий запис."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng cho đăng nhập một lần hoặc để tạo tài khoản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于单点登录或创建账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於單一登入或建立帳號。"
          }
        }
      }
    },
