    "Create an account first so transactions have somewhere to go.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege zuerst ein Konto an, damit Transaktionen einem Konto zugeordnet werden können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε πρώτα έναν λογαριασμό, ώστε οι συναλλαγές να έχουν πού να καταχωριστούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea primero una cuenta para que las transacciones tengan dónde ir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez d’abord un compte pour y enregistrer vos transactions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea prima un conto, così le transazioni avranno dove andare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引を記録する前に、まず口座を作成してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಹಿವಾಟುಗಳನ್ನು ದಾಖಲಿಸಲು ಮೊದಲು ಒಂದು ಖಾತೆಯನ್ನು ರಚಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래를 기록하려면 먼저 계좌를 만드세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak eerst een rekening aan zodat transacties ergens heen kunnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw utwórz konto, aby transakcje miały gdzie trafić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma conta primeiro para que as transações tenham onde ficar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează mai întâi un cont, ca tranzacțiile să aibă unde să meargă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создайте счёт, чтобы было куда записывать транзакции."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej ustvarite račun, da bodo transakcije imele kam iti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிவர்த்தனைகளைப் பதிவுசெய்ய முதலில் ஒரு கணக்கை உருவாக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างบัญชีก่อนเพื่อให้มีที่บันทึกรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemlerin gidecek bir yeri olması için önce bir hesap oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку створіть рахунок, щоб транзакції було куди записувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tạo một tài khoản trước để có nơi ghi giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先创建一个账户，交易才有地方记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先建立一個帳戶，交易才有地方記錄。"
          }
        }
      }
    },
