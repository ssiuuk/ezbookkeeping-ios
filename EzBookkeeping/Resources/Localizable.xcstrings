    "No transactions yet. Tap + to record your first one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Transaktionen. Tippe auf +, um die erste zu erfassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη συναλλαγές. Πατήστε + για να καταγράψετε την πρώτη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay transacciones. Toca + para registrar la primera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune transaction pour l’instant. Touchez + pour enregistrer la première."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna transazione. Tocca + per registrare la prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引はまだありません。+ をタップして最初の取引を記録しましょう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ವಹಿವಾಟುಗಳಿಲ್ಲ. ಮೊದಲನೆಯದನ್ನು ದಾಖಲಿಸಲು + ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 거래가 없습니다. +를 탭해 첫 거래를 기록하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen transacties. Tik op + om je eerste vast te leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak transakcji. Stuknij +, aby zapisać pierwszą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há transações. Toque em + para registrar a primeira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio tranzacție încă. Atinge + ca să o înregistrezi pe prima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакций пока нет. Нажмите +, чтобы добавить первую."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še ni transakcij. Tapnite +, da zabeležite prvo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் பரிவர்த்தனைகள் இல்லை. முதலாவதைப் பதிவுசெய்ய + ஐத் தட்டவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีรายการ แตะ + เพื่อบันทึกรายการแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz işlem yok. İlkini kaydetmek için + simgesine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцій ще немає. Торкніться +, щоб додати першу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có giao dịch nào. Chạm + để ghi giao dịch đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有交易。轻点 + 记录第一笔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有交易。輕點 + 記錄第一筆。"
          }
        }
      }
    },
