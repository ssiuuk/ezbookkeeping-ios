    "Tap a purchase to save it as a transaction, or swipe it away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Zahlung, um sie als Transaktion zu speichern, oder wische sie weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε μια αγορά για να την αποθηκεύσετε ως συναλλαγή ή σύρετέ τη για απόρριψη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una compra para guardarla como transacción o deslízala para quitarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un achat pour l’enregistrer comme transaction, ou balayez-le pour l’ignorer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un acquisto per salvarlo come transazione, oppure scorri per toglierlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いをタップすると取引として保存できます。スワイプで外せます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಹಿವಾಟಾಗಿ ಉಳಿಸಲು ಖರೀದಿಯನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ, ಅಥವಾ ಸ್ವೈಪ್ ಮಾಡಿ ತೆಗೆದುಹಾಕಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제를 탭하면 거래로 저장하고, 밀면 목록에서 뺍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een aankoop om hem als transactie op te slaan, of veeg hem weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij zakup, aby zapisać go jako transakcję, albo przesuń, aby go usunąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma compra para salvá-la como transação ou deslize para removê-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge o cumpărătură ca să o salvezi ca tranzacție sau glisează ca să o elimini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на покупку, чтобы сохранить её как транзакцию, или смахните её."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite nakup, da ga shranite kot transakcijo, ali ga povlecite stran."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிவர்த்தனையாகச் சேமிக்க வாங்குதலைத் தட்டவும், அல்லது ஸ்வைப் செய்து நீக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะการซื้อเพื่อบันทึกเป็นรายการ หรือปัดเพื่อนำออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem olarak kaydetmek için bir alışverişe dokunun veya kaydırarak kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться покупки, щоб зберегти її як транзакцію, або змахніть її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào giao dịch mua để lưu thành giao dịch, hoặc vuốt để bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点消费可保存为交易，或滑动将其移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點消費可儲存為交易，或滑動將其移除。"
          }
        }
      }
    },
    "Tap the ones marked in red to choose what to keep.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die rot markierten, um zu wählen, was bleiben soll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε όσες έχουν κόκκινη σήμανση για να επιλέξετε τι θα μείνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca los marcados en rojo para elegir qué conservar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ceux marqués en rouge pour choisir ce qui reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca quelle segnate in rosso per scegliere cosa tenere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤く表示されたものをタップして、残す内容を選んでください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನು ಉಳಿಸಬೇಕೆಂದು ಆಯ್ಕೆ ಮಾಡಲು ಕೆಂಪು ಗುರುತಿನವುಗಳನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빨간색으로 표시된 항목을 눌러 남길 내용을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de rood gemarkeerde om te kiezen wat blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij oznaczonych na czerwono, aby wybrać, co zostaje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nos marcados em vermelho para escolher o que fica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge-le pe cele marcate cu roșu pentru a alege ce rămâne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на отмеченные красным, чтобы выбрать, что оставить."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite rdeče označene, da izberete, kaj ostane."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதை வைத்திருப்பது என்பதைத் தேர்வுசெய்ய சிவப்பில் குறிக்கப்பட்டவற்றைத் தட்டவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะรายการที่มีสีแดงเพื่อเลือกว่าจะเก็บอะไรไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyin kalacağını seçmek için kırmızı işaretlilere dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться позначених червоним, щоб вибрати, що залишити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào các mục đánh dấu đỏ để chọn giữ lại gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按标红的项目，选择要保留的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按標紅的項目，選擇要保留的內容。"
          }
        }
      }
    },
