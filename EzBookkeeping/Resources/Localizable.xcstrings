    "Move to another book?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In ein anderes Buch verschieben?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακίνηση σε άλλο βιβλίο;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Mover a otro libro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer vers un autre livre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostare in un altro libro?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の帳簿に移動しますか？"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೇರೆ ಪುಸ್ತಕಕ್ಕೆ ಸರಿಸಬೇಕೆ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 가계부로 이동할까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar een ander boek verplaatsen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieść do innej księgi?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover para outro livro?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Muți în alt registru?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить в другую книгу?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Želite premakniti v drugo knjigo?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறு புத்தகத்திற்கு நகர்த்தவா?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายไปยังสมุดบัญชีอื่นไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir deftere taşınsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістити в іншу книгу?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang sổ khác?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动到其他账本？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移到其他帳本嗎？"
          }
        }
      }
    },
    "Moving to another book needs the server. Try again when it can be reached.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Verschieben in ein anderes Buch wird der Server gebraucht. Versuche es erneut, wenn er erreichbar ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μετακίνηση σε άλλο βιβλίο χρειάζεται τον διακομιστή. Δοκιμάστε ξανά όταν είναι προσβάσιμος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mover a otro libro hace falta el servidor. Vuelve a intentarlo cuando se pueda conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer vers un autre livre nécessite le serveur. Réessayez quand il sera joignable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per spostare in un altro libro serve il server. Riprova quando è raggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の帳簿への移動にはサーバーが必要です。接続できるときにもう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೊಂದು ಪುಸ್ತಕಕ್ಕೆ ಸರಿಸಲು ಸರ್ವರ್ ಬೇಕು. ಅದು ತಲುಪಿದಾಗ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 장부로 옮기려면 서버가 필요합니다. 연결되면 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaatsen naar een ander boek kan alleen via de server. Probeer het opnieuw als hij bereikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeniesienie do innej księgi wymaga serwera. Spróbuj ponownie, gdy będzie dostępny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover para outro livro precisa do servidor. Tente de novo quando ele puder ser acessado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutarea în altă carte are nevoie de server. Încearcă din nou când poate fi accesat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для переноса в другую книгу нужен сервер. Попробуйте снова, когда он станет доступен."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za premik v drugo knjigo je potreben strežnik. Poskusite znova, ko bo dosegljiv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறு புத்தகத்திற்கு நகர்த்த சேவையகம் தேவை. அணுக முடிந்ததும் மீண்டும் முயலவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การย้ายไปสมุดบัญชีอื่นต้องใช้เซิร์ฟเวอร์ ลองอีกครั้งเมื่อเชื่อมต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir deftere taşımak için sunucu gerekir. Ulaşılabildiğinde yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перенесення в іншу книгу потрібен сервер. Спробуйте знову, коли він стане доступним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang sổ khác cần có máy chủ. Hãy thử lại khi kết nối được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到其他账本需要连接服务器。请在可以连接时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移至其他帳本需要連線至伺服器。請在可以連線時重試。"
          }
        }
      }
    },
