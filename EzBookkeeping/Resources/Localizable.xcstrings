    "Tap Add to record your first one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Hinzufügen, um deine erste zu erfassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
