    "They are sent by themselves as soon as the server answers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden automatisch gesendet, sobald der Server antwortet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνονται αυτόματα μόλις απαντήσει ο διακομιστής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envían solos en cuanto el servidor responda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils sont envoyés automatiquement dès que le serveur répond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono inviate da sole appena il server risponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが応答するとすぐに自動で送信されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸರ್ವರ್ ಉತ್ತರಿಸಿದ ತಕ್ಷಣ ಇವು ತಾವಾಗಿಯೇ ಕಳುಹಿಸಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 응답하면 바로 자동으로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze worden vanzelf verstuurd zodra de server antwoordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaną wysłane automatycznie, gdy tylko serwer odpowie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles são enviados sozinhos assim que o servidor responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt trimise singure imediat ce serverul răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они отправятся сами, как только сервер ответит."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslane bodo same, takoj ko se strežnik odzove."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேவையகம் பதிலளித்தவுடன் இவை தானாகவே அனுப்பப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะส่งให้เองทันทีที่เซิร์ฟเวอร์ตอบกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu yanıt verir vermez kendiliğinden gönderilirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони надішлються самі, щойно сервер відповість."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng sẽ tự được gửi ngay khi máy chủ phản hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器一响应就会自动发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器一回應就會自動傳送。"
          }
        }
      }
    },
