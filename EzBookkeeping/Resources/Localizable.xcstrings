    "Saving moves this transaction to %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern wird diese Transaktion nach %@ verschoben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποθήκευση μεταφέρει αυτή τη συναλλαγή στο %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar, esta transacción se moverá a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement déplace cette transaction vers %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvando, questa transazione viene spostata in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、この取引は %@ に移動します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿಸಿದರೆ ಈ ವಹಿವಾಟು %@ ಗೆ ಸರಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 이 거래가 %@(으)로 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij opslaan wordt deze transactie naar %@ verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisanie przeniesie tę transakcję do: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao salvar, esta transação será movida para %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La salvare, tranzacția este mutată în %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сохранении транзакция будет перенесена в %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob shranjevanju se ta transakcija premakne v %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமித்தால் இந்தப் பரிவர்த்தனை %@ க்கு நகரும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อบันทึก รายการนี้จะถูกย้ายไปที่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmek bu işlemi %@ defterine taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час збереження транзакцію буде перенесено до %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi lưu, giao dịch này sẽ được chuyển sang %@."
          }
        },
        "zh-Hans": {
