    "Added %@ at %@ to To review.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bei %2$@ zu „Zu prüfen“ hinzugefügt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προστέθηκε %1$@ στο %2$@ στο «Για έλεγχο»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en %2$@ añadido a Por revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chez %2$@ ajouté à À vérifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ da %2$@ aggiunto a Da controllare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ での %1$@ を確認待ちに追加しました。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ನಲ್ಲಿ %1$@ ಅನ್ನು ಪರಿಶೀಲನೆಗೆ ಸೇರಿಸಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 %1$@을(를) 검토 대기에 추가했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bij %2$@ toegevoegd aan Te controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodano %1$@ w %2$@ do listy Do sprawdzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ em %2$@ adicionado a Para revisar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ la %2$@ adăugat la De verificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ в %2$@ добавлено в «На проверку»."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pri %2$@ dodano v Za pregled."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ இல் %1$@ சரிபார்ப்பில் சேர்க்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม %1$@ ที่ %2$@ ในรอตรวจสอบแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ için %1$@ İncelenecek listesine eklendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ у %2$@ додано до «На перевірку»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thêm %1$@ tại %2$@ vào Cần xem xét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %2$@ 的 %1$@ 加入待确认。"
          }
