    "It was deleted on this phone, and the server hasn't been told yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurde auf diesem Telefon gelöscht, und der Server weiß es noch nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφηκε σε αυτό το τηλέφωνο και ο διακομιστής δεν έχει ενημερωθεί ακόμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó en este teléfono y aún no se ha avisado al servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle a été supprimée sur ce téléphone et le serveur n’a pas encore été prévenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata eliminata su questo telefono e il server non è ancora stato avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で削除されましたが、まだサーバーには反映されていません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದನ್ನು ಈ ಫೋನ್‌ನಲ್ಲಿ ಅಳಿಸಲಾಗಿದೆ, ಆದರೆ ಸರ್ವರ್‌ಗೆ ಇನ್ನೂ ತಿಳಿಸಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대전화에서 삭제되었지만 아직 서버에는 반영되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij is op deze telefoon verwijderd en de server weet het nog niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Została usunięta na tym telefonie, a serwer jeszcze o tym nie wie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela foi excluída neste telefone, e o servidor ainda não foi avisado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A fost ștearsă pe acest telefon, iar serverul nu a aflat încă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она удалена на этом телефоне, а сервер ещё об этом не знает."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisana je bila na tem telefonu, strežnik pa za to še ne ve."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இந்தத் தொலைபேசியில் நீக்கப்பட்டது, சேவையகத்திற்கு இன்னும் தெரிவிக்கப்படவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้ถูกลบในโทรศัพท์นี้ และยังไม่ได้แจ้งเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda silindi ve sunucuya henüz bildirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її видалено на цьому телефоні, а сервер ще про це не знає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đã bị xóa trên điện thoại này và máy chủ chưa được báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它已在本机删除，服务器还不知道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它已在本機刪除，伺服器還不知道。"
          }
        }
      }
    },
