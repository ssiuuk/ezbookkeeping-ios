    "Connect to your ezBookkeeping server to get started. You can add more servers later in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit deinem ezBookkeeping-Server, um loszulegen. Weitere Server kannst du später in den Einstellungen hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στον διακομιστή ezBookkeeping για να ξεκινήσετε. Μπορείτε να προσθέσετε περισσότερους διακομιστές αργότερα από τις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a tu servidor de ezBookkeeping para empezar. Puedes añadir más servidores más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à votre serveur ezBookkeeping pour commencer. Vous pourrez ajouter d’autres serveurs plus tard dans les Paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegati al tuo server ezBookkeeping per iniziare. Potrai aggiungere altri server più tardi nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ezBookkeeping サーバーに接続して始めましょう。サーバーは後から設定で追加できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಾರಂಭಿಸಲು ನಿಮ್ಮ ezBookkeeping ಸರ್ವರ್‌ಗೆ ಸಂಪರ್ಕಿಸಿ. ನಂತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಇನ್ನಷ್ಟು ಸರ್ವರ್‌ಗಳನ್ನು ಸೇರಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ezBookkeeping 서버에 연결하여 시작하세요. 서버는 나중에 설정에서 더 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met je ezBookkeeping-server om te beginnen. Je kunt later meer servers toevoegen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się ze swoim serwerem ezBookkeeping, aby zacząć. Kolejne serwery możesz dodać później w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se ao seu servidor ezBookkeeping para começar. Você pode adicionar mais servidores depois em Configurações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te la serverul tău ezBookkeeping pentru a începe. Poți adăuga mai multe servere mai târziu din Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к своему серверу ezBookkeeping, чтобы начать. Другие серверы можно добавить позже в настройках."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za začetek se povežite s svojim strežnikom ezBookkeeping. Več strežnikov lahko pozneje dodate v nastavitvah."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடங்க உங்கள் ezBookkeeping சேவையகத்துடன் இணைக்கவும். பின்னர் அமைப்புகளில் மேலும் சேவையகங்களைச் சேர்க்கலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อกับเซิร์ฟเวอร์ ezBookkeeping ของคุณเพื่อเริ่มต้น คุณเพิ่มเซิร์ฟเวอร์อื่นได้ภายหลังในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için ezBookkeeping sunucunuza bağlanın. Daha fazla sunucuyu daha sonra Ayarlar'dan ekleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться до свого сервера ezBookkeeping, щоб почати. Інші сервери можна додати пізніше в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối với máy chủ ezBookkeeping của bạn để bắt đầu. Bạn có thể thêm máy chủ khác sau trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到你的 ezBookkeeping 服务器即可开始使用。之后可以在“设置”中添加更多服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線到你的 ezBookkeeping 伺服器即可開始使用。之後可以在「設定」中新增更多伺服器。"
          }
        }
      }
    },
