    "Enter the 6-digit code from your authenticator app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den 6-stelligen Code aus deiner Authenticator-App ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τον 6ψήφιο κωδικό από την εφαρμογή ελέγχου ταυτότητας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código de 6 dígitos de tu aplicación de autenticación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code à 6 chiffres de votre application d’authentification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice di 6 cifre dell’app di autenticazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリに表示される 6 桁のコードを入力してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ದೃಢೀಕರಣ ಆ್ಯಪ್‌ನಲ್ಲಿರುವ 6 ಅಂಕಿಯ ಕೋಡ್ ನಮೂದಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱에 표시된 6자리 코드를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de 6-cijferige code uit je authenticator-app in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz 6-cyfrowy kod z aplikacji uwierzytelniającej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código de 6 dígitos do seu app autenticador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu codul de 6 cifre din aplicația de autentificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите 6-значный код из приложения-аутентификатора."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite 6-mestno kodo iz aplikacije za preverjanje pristnosti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அங்கீகரிப்பு ஆப்ஸில் உள்ள 6 இலக்கக் குறியீட்டை உள்ளிடவும்."
          }
