    "Other details (project, tags, receipts or location) differ too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch andere Angaben (Projekt, Schlagwörter, Belege oder Ort) unterscheiden sich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαφέρουν και άλλα στοιχεία (έργο, ετικέτες, αποδείξεις ή τοποθεσία)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros datos (proyecto, etiquetas, recibos o ubicación) también son distintos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres détails (projet, étiquettes, reçus ou lieu) diffèrent aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche altri dettagli (progetto, etichette, ricevute o luogo) sono diversi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他の内容（プロジェクト、タグ、レシート、位置情報）も異なります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತರ ವಿವರಗಳೂ (ಯೋಜನೆ, ಟ್ಯಾಗ್‌ಗಳು, ರಸೀದಿಗಳು ಅಥವಾ ಸ್ಥಳ) ಬೇರೆಯಾಗಿವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 정보(프로젝트, 태그, 영수증 또는 위치)도 다릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook andere gegevens (project, labels, bonnen of locatie) verschillen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Różnią się też inne dane (projekt, tagi, paragony lub lokalizacja)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros detalhes (projeto, tags, recibos ou local) também são diferentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferă și alte detalii (proiect, etichete, chitanțe sau locație)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие данные (проект, теги, чеки или место) тоже отличаются."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razlikujejo se tudi druge podrobnosti (projekt, oznake, računi ali lokacija)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிற விவரங்களும் (திட்டம், குறிச்சொற்கள், ரசீதுகள் அல்லது இடம்) வேறுபடுகின்றன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายละเอียดอื่น (โครงการ แท็ก ใบเสร็จ หรือตำแหน่ง) ก็ต่างกันด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer ayrıntılar (proje, etiketler, fişler veya konum) da farklı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші дані (проєкт, теги, чеки або місце) теж відрізняються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chi tiết khác (dự án, thẻ, hóa đơn hoặc vị trí) cũng khác nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他信息（项目、标签、收据或位置）也不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他資訊（專案、標籤、收據或位置）也不同。"
          }
        }
      }
    },
