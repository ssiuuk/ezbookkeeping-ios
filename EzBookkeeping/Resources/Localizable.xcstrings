    "The app forgets %@ and signs out of it. Your data stays on the server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App vergisst %1$@ und meldet sich dort ab. Deine Daten bleiben auf dem Server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή ξεχνά τον %1$@ και αποσυνδέεται από αυτόν. Τα δεδομένα σας παραμένουν στον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación olvida %1$@ y cierra la sesión. Tus datos se quedan en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application oublie %1$@ et s’en déconnecte. Vos données restent sur le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app dimentica %1$@ ed esce dall’account. I tuoi dati restano sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは %1$@ を削除してログアウトします。データはサーバーに残ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ %1$@ ಅನ್ನು ಮರೆಯುತ್ತದೆ ಮತ್ತು ಅದರಿಂದ ಲಾಗ್ ಔಟ್ ಆಗುತ್ತದೆ. ನಿಮ್ಮ ಡೇಟಾ ಸರ್ವರ್‌ನಲ್ಲೇ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 %1$@을(를) 삭제하고 로그아웃합니다. 데이터는 서버에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app vergeet %1$@ en logt daar uit. Je gegevens blijven op de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja zapomni %1$@ i wyloguje się z niego. Twoje dane pozostaną na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O app esquece %1$@ e sai da conta. Seus dados continuam no servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația uită %1$@ și se deconectează de la el. Datele tale rămân pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение забудет %1$@ и выйдет из аккаунта. Ваши данные останутся на сервере."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija pozabi %1$@ in se odjavi. Vaši podatki ostanejo na strežniku."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப்ஸ் %1$@ ஐ மறந்து அதிலிருந்து வெளியேறும். உங்கள் தரவு சேவையகத்திலேயே இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปจะลืม %1$@ และออกจากระบบ ข้อมูลของคุณยังอยู่บนเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama %1$@ sunucusunu unutur ve oturumu kapatır. Verileriniz sunucuda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок забуде %1$@ і вийде з облікового запису. Ваші дані залишаться на сервері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng sẽ quên %1$@ và đăng xuất khỏi đó. Dữ liệu của bạn vẫn ở trên máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用将忘记 %1$@ 并退出登录。你的数据仍保留在服务器上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 會忘記 %1$@ 並登出。你的資料仍保留在伺服器上。"
          }
        }
      }
    },
    "The card or pass it was paid with.": {
