    "You deleted this transaction on this phone, but it was changed on the server since.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diese Buchung auf diesem Telefon gelöscht, aber sie wurde inzwischen auf dem Server geändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράψατε αυτή τη συναλλαγή σε αυτό το τηλέφωνο, αλλά στο μεταξύ άλλαξε στον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminaste esta transacción en este teléfono, pero desde entonces se cambió en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez supprimé cette transaction sur ce téléphone, mais elle a été modifiée sur le serveur depuis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai eliminato questa transazione su questo telefono, ma nel frattempo è stata modificata sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末でこの取引を削除しましたが、その後サーバーで変更されています。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಈ ವಹಿವಾಟನ್ನು ಈ ಫೋನ್‌ನಲ್ಲಿ ಅಳಿಸಿದ್ದೀರಿ, ಆದರೆ ನಂತರ ಅದು ಸರ್ವರ್‌ನಲ್ಲಿ ಬದಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대전화에서 이 거래를 삭제했지만, 그 후 서버에서 변경되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt deze transactie op deze telefoon verwijderd, maar hij is sindsdien op de server gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto tę transakcję na tym telefonie, ale od tego czasu zmieniono ją na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você excluiu esta transação neste telefone, mas ela foi alterada no servidor desde então."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai șters această tranzacție pe acest telefon, dar între timp a fost modificată pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы удалили эту операцию на этом телефоне, но с тех пор она была изменена на сервере."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To transakcijo ste izbrisali na tem telefonu, vendar je bila medtem spremenjena na strežniku."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பரிவர்த்தனையை இந்தத் தொலைபேசியில் நீக்கினீர்கள், ஆனால் அதன் பிறகு சேவையகத்தில் மாற்றப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณลบรายการนี้ในโทรศัพท์นี้ แต่หลังจากนั้นรายการถูกเปลี่ยนในเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemi bu telefonda sildiniz, ancak o zamandan beri sunucuda değiştirildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви видалили цю операцію на цьому телефоні, але відтоді її змінено на сервері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã xóa giao dịch này trên điện thoại này, nhưng sau đó nó đã được sửa trên máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在本机删除了这笔交易，但之后它在服务器上被修改了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在本機刪除了這筆交易，但之後它在伺服器上被修改了。"
          }
        }
      }
    },
    "Your sign-in expired. Please sign in again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anmeldung ist abgelaufen. Bitte melde dich erneut an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεσή σας έληξε. Συνδεθείτε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión ha caducado. Vuelve a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a expiré. Veuillez vous reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso è scaduto. Accedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインの有効期限が切れました。もう一度ログインしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲಾಗ್ ಇನ್ ಅವಧಿ ಮುಗಿದಿದೆ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಲಾಗ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 만료되었습니다. 다시 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je login is verlopen. Log opnieuw in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja wygasła. Zaloguj się ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu login expirou. Entre novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea a expirat. Conectează-te din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия входа истёк. Войдите снова."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava je potekla. Prijavite se znova."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உள்நுழைவு காலாவதியானது. மீண்டும் உள்நுழையவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าสู่ระบบหมดอายุแล้ว โปรดเข้าสู่ระบบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumunuzun süresi doldu. Lütfen tekrar giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін дії входу минув. Увійдіть знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已过期，请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入已過期，請重新登入。"
          }
        }
      }
    },
