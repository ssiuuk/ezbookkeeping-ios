            "value": "Der Betrag mit Währung, etwa 4,50 £."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ποσό με το νόμισμά του, π.χ. £4,50."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe con su moneda, como 4,50 £."
          }
        },
        "fr": {
