    "This server only allows single sign-on. Use \"Sign in on the web page\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server erlaubt nur Single Sign-On. Verwende „Auf der Webseite anmelden“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο διακομιστής επιτρέπει μόνο ενιαία σύνδεση. Χρησιμοποιήστε το «Σύνδεση στην ιστοσελίδα»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor solo permite el inicio de sesión único. Usa «Iniciar sesión en la página web»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n’autorise que l’authentification unique. Utilisez « Se connecter sur la page web »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server consente solo il single sign-on. Usa «Accedi dalla pagina web»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーはシングルサインオンのみ利用できます。「ウェブページでログイン」を使ってください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸರ್ವರ್ ಏಕ ಸೈನ್-ಆನ್ ಅನ್ನು ಮಾತ್ರ ಅನುಮತಿಸುತ್ತದೆ. \"ವೆಬ್ ಪುಟದಲ್ಲಿ ಲಾಗ್ ಇನ್ ಮಾಡಿ\" ಬಳಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 싱글 사인온만 허용합니다. \"웹 페이지에서 로그인\"을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server staat alleen single sign-on toe. Gebruik ‘Inloggen via de webpagina’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten serwer pozwala tylko na logowanie jednokrotne. Użyj opcji „Zaloguj się na stronie internetowej”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor só permite login único (SSO). Use \"Entrar pela página web\"."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest server permite doar autentificarea unică. Folosește „Conectează-te pe pagina web”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер разрешает только единый вход. Используйте «Войти на веб-странице»."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta strežnik dovoljuje samo enotno prijavo. Uporabite »Prijava na spletni strani«."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சேவையகம் ஒற்றை உள்நுழைவை மட்டுமே அனுமதிக்கிறது. \"இணையப் பக்கத்தில் உள்நுழை\" என்பதைப் பயன்படுத்தவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์นี้อนุญาตเฉพาะการลงชื่อเข้าใช้ครั้งเดียว โปรดใช้ \"เข้าสู่ระบบบนหน้าเว็บ\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu yalnızca tek oturum açmaya izin veriyor. \"Web sayfasında giriş yap\" seçeneğini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сервер дозволяє лише єдиний вхід. Скористайтеся «Увійти на вебсторінці»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ này chỉ cho phép đăng nhập một lần. Hãy dùng \"Đăng nhập trên trang web\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器只允许单点登录，请使用“在网页上登录”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個伺服器只允許單一登入，請使用「在網頁上登入」。"
          }
        }
      }
    },
    "This transaction was also changed on the server after you changed it on this phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Buchung wurde auch auf dem Server geändert, nachdem du sie auf diesem Telefon geändert hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η συναλλαγή άλλαξε και στον διακομιστή αφού την αλλάξατε σε αυτό το τηλέφωνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transacción también se cambió en el servidor después de que la cambiaras en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette transaction a aussi été modifiée sur le serveur après que vous l’avez modifiée sur ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa transazione è stata modificata anche sul server dopo che l’hai modificata su questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で変更した後に、この取引はサーバーでも変更されました。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಈ ಫೋನ್‌ನಲ್ಲಿ ಬದಲಾಯಿಸಿದ ನಂತರ ಈ ವಹಿವಾಟು ಸರ್ವರ್‌ನಲ್ಲೂ ಬದಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대전화에서 변경한 뒤 이 거래가 서버에서도 변경되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze transactie is ook op de server gewijzigd nadat je hem op deze telefoon wijzigde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta transakcja została zmieniona także na serwerze po tym, jak zmieniono ją na tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transação também foi alterada no servidor depois que você a alterou neste telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această tranzacție a fost modificată și pe server după ce ai modificat-o pe acest telefon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта операция была изменена и на сервере после того, как вы изменили её на этом телефоне."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta transakcija je bila spremenjena tudi na strežniku, potem ko ste jo spremenili na tem telefonu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தொலைபேசியில் நீங்கள் மாற்றிய பிறகு இந்தப் பரிவர்த்தனை சேவையகத்திலும் மாற்றப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้ถูกเปลี่ยนในเซิร์ฟเวอร์ด้วย หลังจากที่คุณเปลี่ยนในโทรศัพท์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, siz bu telefonda değiştirdikten sonra sunucuda da değiştirildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю операцію змінено й на сервері після того, як ви змінили її на цьому телефоні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch này cũng đã được sửa trên máy chủ sau khi bạn sửa trên điện thoại này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在本机修改这笔交易后，服务器上也修改了它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在本機修改這筆交易後，伺服器上也修改了它。"
          }
        }
      }
    },
    "This transaction was deleted on the server after you changed it on this phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Buchung wurde auf dem Server gelöscht, nachdem du sie auf diesem Telefon geändert hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η συναλλαγή διαγράφηκε στον διακομιστή αφού την αλλάξατε σε αυτό το τηλέφωνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transacción se eliminó en el servidor después de que la cambiaras en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette transaction a été supprimée sur le serveur après que vous l’avez modifiée sur ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa transazione è stata eliminata sul server dopo che l’hai modificata su questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で変更した後に、この取引はサーバーで削除されました。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಈ ಫೋನ್‌ನಲ್ಲಿ ಬದಲಾಯಿಸಿದ ನಂತರ ಈ ವಹಿವಾಟನ್ನು ಸರ್ವರ್‌ನಲ್ಲಿ ಅಳಿಸಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대전화에서 변경한 뒤 이 거래가 서버에서 삭제되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze transactie is op de server verwijderd nadat je hem op deze telefoon wijzigde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta transakcja została usunięta na serwerze po tym, jak zmieniono ją na tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transação foi excluída no servidor depois que você a alterou neste telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această tranzacție a fost ștearsă pe server după ce ai modificat-o pe acest telefon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта операция была удалена на сервере после того, как вы изменили её на этом телефоне."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta transakcija je bila izbrisana na strežniku, potem ko ste jo spremenili na tem telefonu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தொலைபேசியில் நீங்கள் மாற்றிய பிறகு இந்தப் பரிவர்த்தனை சேவையகத்தில் நீக்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้ถูกลบในเซิร์ฟเวอร์ หลังจากที่คุณเปลี่ยนในโทรศัพท์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, siz bu telefonda değiştirdikten sonra sunucuda silindi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю операцію видалено на сервері після того, як ви змінили її на цьому телефоні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch này đã bị xóa trên máy chủ sau khi bạn sửa trên điện thoại này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在本机修改这笔交易后，服务器上删除了它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在本機修改這筆交易後，伺服器上刪除了它。"
          }
        }
      }
    },
